# File này Vite TỰ ĐỘNG dùng khi build production (npm run build / docker build),
# không cần khai báo gì thêm trong Dockerfile. Khi chạy "npm run dev" (local), Vite
# vẫn dùng file .env như bình thường, KHÔNG dùng file này.

# Gọi API qua đường dẫn tương đối -> Nginx (nginx.conf) sẽ proxy "/api/*" và
# "/oauth2/*", "/login/oauth2/*" sang container backend (service "backend" trong
# docker-compose.yml, cùngshared-network). Nhờ vậy frontend và backend dùng chung
# origin, không cần cấu hình CORS ở backend cho domain production.
VITE_API_BASE_URL=/api
VITE_OAUTH2_LOGIN_PATH=/oauth2/authorization/google

# Chế độ thanh toán thật khi lên production (đổi từ "mock" sang "real" khi backend
# đã có endpoint VNPay thật)
VITE_PAYMENT_MODE=mock
