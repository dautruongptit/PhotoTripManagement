# Google OAuth Client ID (Google Cloud Console > APIs & Services > Credentials)
# Đây là Client ID TẠM để dựng giao diện - thay bằng Client ID thật của bạn trước khi deploy thật.
VITE_GOOGLE_CLIENT_ID=762204384061-n4ngsh81its82lno66tulvtpiu4esume.apps.googleusercontent.com

# URL gốc của backend Spring Boot (không có dấu / ở cuối)
VITE_API_BASE_URL=http://localhost:8068/api/v1

# Chế độ thanh toán VNPay:
#   mock -> mô phỏng màn hình VNPay ngay trong trình duyệt, không cần backend (để dựng UI)
#   real -> gọi backend tạo link thanh toán thật rồi chuyển hướng sang VNPay
VITE_PAYMENT_MODE=mock
