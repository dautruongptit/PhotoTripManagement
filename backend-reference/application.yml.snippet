# Thêm vào application.yml (hoặc application.properties) hiện có của backend.
# Client ID phải TRÙNG với VITE_GOOGLE_CLIENT_ID ở frontend.

google:
  client-id: "1234567890-placeholder1234567890abcdefgh.apps.googleusercontent.com"

vnpay:
  tmn-code: "YOUR_TMN_CODE"          # Mã website merchant, VNPay cấp khi đăng ký
  hash-secret: "YOUR_HASH_SECRET"    # Secret key merchant — tuyệt đối không lộ ra frontend/git
  pay-url: "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"  # Production: https://vnpayment.vn/paymentv2/vpcpay.html
  return-url: "http://localhost:5173/payment/vnpay-return"       # Trang FE nhận kết quả, đổi thành domain thật lúc deploy
